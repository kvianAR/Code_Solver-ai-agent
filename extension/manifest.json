{
  "manifest_version": 3,
  "name": "LeetCode AI Agent • Practice Autopilot",
  "version": "2.8.4",
  "description": "Daily AI-generated LeetCode solutions, account submissions, reminders, and contest calendar.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://leetcode.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{"matches": ["https://leetcode.com/*"], "js": ["leetcode.js"], "run_at": "document_idle"}],
  "action": {"default_title": "LeetCode AI Agent status", "default_icon": "icon.png", "default_popup": "popup.html"},
  "icons": {"128": "icon.png"},
  "options_page": "dashboard.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
